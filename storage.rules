rules_version = '2';

// Deploy: Firebase Console → Storage → Rules, or: firebase deploy --only storage
// Paths used by the admin product image uploader: products/images/{userId}/{fileName}
service firebase.storage {
  match /b/{bucket}/o {
    match /products/images/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
